[celbridge]
celbridge-version = "1.0.0"
project-version = "1.0.0"

# 'hide' keeps resources out of the Explorer tree. 'search-exclude' also keeps them out of search.
# Both take glob patterns, e.g. "Python/.venv/**".
[celbridge.resources]
hide = [".cache", ".DS_Store", ".github", ".gitignore", ".idea", ".venv", "site"]
search-exclude = [".cache", ".venv", "__pycache__", "site"]

[[shortcut]]
resource = "site-server.console"
icon = "bs-1-circle-fill"
area = "bottom"

[[shortcut]]
resource = "site_preview.webview"
icon = "bs-2-circle-fill"
area = "side"

[[shortcut]]
resource = "site-re-builder.console"
icon = "bs-3-circle-fill"
area = "bottom"
