# A console for rebuilding the site on demand. Click Build to run a full strict build into
# site/ and write the redirect stubs, the same steps the publish workflow runs.
[session]
type = "python"

[session.python]
python_version = "3.13"
dependencies = ["zensical==0.0.55"]

[[session.shortcut]]
label = "Build"
icon = "bs-hammer"
text = "run build.py"
