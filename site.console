[session]
type = "python"

[session.python]
python_version = "3.13"
dependencies = ["zensical==0.0.55"]
script = "run build.py serve --background"

[[session.trigger]]
pattern = "redirects.csv"
command = "run build.py redirects"

[[session.shortcut]]
label = "Build"
icon = "bs-hammer"
text = "run build.py"
