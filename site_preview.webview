# The dev server serves the site under the path in zensical.toml's site_url. That is the root
# now that site_url is https://learn.celbridge.org/; change this if site_url moves again.
source_url = "http://localhost:8000/"
show_url_bar = true
show_bookmarks_bar = false

[[bookmarks]]
url = "http://localhost:8000/"
name = "localhost"
